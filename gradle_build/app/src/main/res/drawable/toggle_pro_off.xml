<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="270" android:startColor="#FF152331"
                android:endColor="#FF0B121B" />
            <stroke android:width="1dp" android:color="#FF48A9C5" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#FF05090E" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient android:angle="270" android:startColor="#FF263847"
                        android:endColor="#FF111A24" />
                    <stroke android:width="1dp" android:color="#FF456171" />
                    <padding android:left="3dp" android:top="2dp"
                        android:right="3dp" android:bottom="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
