<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient android:angle="270" android:startColor="#ffff7777" android:endColor="#ffbb1724" />
            <stroke android:width="2dp" android:color="#ffffd5d5" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="4dp" />
                    <solid android:color="#ff250509" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="4dp" />
                    <gradient android:angle="270" android:startColor="#ffff8a8e" android:centerColor="#fff03740" android:endColor="#ffbd1725" />
                    <stroke android:width="2dp" android:color="#fff3d4d5" />
                    <padding android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
