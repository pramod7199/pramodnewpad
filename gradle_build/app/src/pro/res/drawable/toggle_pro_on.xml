<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <gradient android:angle="270" android:startColor="#ffff7777" android:endColor="#ffbc1f2c" />
            <stroke android:width="1dp" android:color="#ff74131b" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#ff23070a" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <gradient android:angle="270" android:startColor="#ffff7777" android:centerColor="#ffec363f" android:endColor="#ffb41622" />
                    <stroke android:width="1dp" android:color="#ff77151e" />
                    <padding android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
