<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/rootMain" android:background="#fff1f0eb" android:padding="6dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/topControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/spd20_fascia"
        android:orientation="vertical"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.7"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="6dp">

                <TextView
                    android:id="@+id/txtBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="PRAMOD OCTAPAD SPD-20 PRO"
                    android:textColor="#ffffffff"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMidiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="MIDI: disconnected"
                    android:textColor="#ff00ff00"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtKitName"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="2.3"
                android:background="@drawable/lcd_pro"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="KIT 1"
                android:textColor="#ffdfff78"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPrevKit"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginLeft="4dp"
                android:layout_weight="0.65"
                android:background="@drawable/toggle_pro_off"
                android:minWidth="0dp"
                android:text="−"
                android:textColor="#ffffffff"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNextKit"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginLeft="3dp"
                android:layout_weight="0.65"
                android:background="@drawable/toggle_pro_off"
                android:minWidth="0dp"
                android:text="+"
                android:textColor="#ffffffff"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <Button android:id="@+id/btnEditMode" style="@style/ProTopButton" android:text="EDIT" />
            <Button android:id="@+id/btnThemeToggle" style="@style/ProTopButton" android:text="THEME" />
            <Button android:id="@+id/btnRenameKit" style="@style/ProTopButton" android:text="NAME" />
            <Button android:id="@+id/btnEq" style="@style/ProTopButton" android:text="FX / ADV" />
            <Button android:id="@+id/btnPadEdit" style="@style/ProTopButton" android:text="PAD EDIT" />
            <Button android:id="@+id/btnSaveKit" style="@style/ProTopButton" android:text="SAVE" />
            <Button android:id="@+id/btnLoadKit" style="@style/ProTopButton" android:text="LOAD" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button android:id="@+id/btnVelocity" style="@style/ProTopButton" android:text="VEL OFF" />
            <Button android:id="@+id/btnMidiMap" style="@style/ProTopButton" android:text="MAP OFF" />
            <Button android:id="@+id/btnMidiConnect" style="@style/ProTopButton" android:text="MIDI OFF" />
            <Button android:id="@+id/btnCCCtrl" style="@style/ProTopButton" android:text="CC CTRL" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="4dp"
                android:paddingRight="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOL"
                    android:textColor="#ffffffff"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progressBackgroundTint="#ff263847"
                    android:progressTint="#ff48a9c5"
                    android:thumbTint="#ff83f4ff" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="3dp"
                android:paddingRight="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PITCH"
                    android:textColor="#ffffffff"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekPitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="150"
                    android:progressBackgroundTint="#ff263847"
                    android:progressTint="#ff48a9c5"
                    android:thumbTint="#ff83f4ff" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/fxControlBar" android:background="@drawable/panel_pro" android:padding="2dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="40dp">
        <CheckBox android:textSize="10sp" android:textColor="#ff00ffff" android:id="@+id/chkDelay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DLY"/>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:textSize="9sp" android:textStyle="bold" android:textColor="#ffffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TIME"/>
            <SeekBar android:id="@+id/seekDelayTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="500"/>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:textSize="9sp" android:textStyle="bold" android:textColor="#ffffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LEVEL"/>
            <SeekBar android:id="@+id/seekDelayLevel" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
        </LinearLayout>
        <View android:background="#ff444444" android:layout_width="1dp" android:layout_height="match_parent" android:layout_margin="4dp"/>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:textSize="9sp" android:textStyle="bold" android:textColor="#ffffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HI-EQ"/>
            <SeekBar android:id="@+id/seekEqHigh" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200"/>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:textSize="9sp" android:textStyle="bold" android:textColor="#ffffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MID-EQ"/>
            <SeekBar android:id="@+id/seekEqMid" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200"/>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <TextView android:textSize="9sp" android:textStyle="bold" android:textColor="#ffffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOW-EQ"/>
            <SeekBar android:id="@+id/seekEqLow" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/advControlBar" android:background="@drawable/panel_pro" android:padding="2dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="76dp">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:textSize="9sp" android:textStyle="bold" android:textColor="#ffffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ATTACK"/>
                <SeekBar android:id="@+id/seekAttack" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="500"/>
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:textSize="9sp" android:textStyle="bold" android:textColor="#ffffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RELEASE"/>
                <SeekBar android:id="@+id/seekRelease" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="500"/>
            </LinearLayout>
            <View android:background="#ff444444" android:layout_width="1dp" android:layout_height="match_parent" android:layout_margin="4dp"/>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:textSize="9sp" android:textStyle="bold" android:textColor="#ffffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CHOKE GRP"/>
                <SeekBar android:id="@+id/seekChokeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="4"/>
            </LinearLayout>
            <Button android:textSize="10sp" android:textColor="#ffffffff" android:id="@+id/btnPadColor" android:background="#ff333333" android:layout_width="0dp" android:layout_height="match_parent" android:text="COLOR" android:layout_weight="1"/>
            <!-- Sign-in info moved from accountRow into ADV bar — pads get full height -->
            <TextView android:id="@+id/txtSignedInAs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:layout_marginLeft="8dp" android:textSize="10sp" android:textColor="#ff00afff" android:singleLine="true" android:ellipsize="end" android:text=""/>
            <Button android:id="@+id/btnSignOut" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:text="Sign Out" android:textSize="9sp" android:textColor="#ffffffff" android:background="@drawable/btn_3d_dark" android:paddingStart="8dp" android:paddingEnd="8dp"/>
            <!-- Drums APK me sign-out yahan dikhega; baaki flavors me gone -->
            <Button android:id="@+id/btnDrumsSignOut" android:visibility="gone" android:textSize="10sp" android:textColor="#ffffffff" android:background="@drawable/btn_3d_dark" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginLeft="8dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Sign Out"/>
        </LinearLayout>
        <!-- Master Volume + Master Pitch — inside ADV panel so pads stay full-size -->
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="#ff000000" android:padding="2dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:textSize="9sp" android:textStyle="bold" android:textColor="#ff00ff00" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:text="M-VOL"/>
            <SeekBar android:id="@+id/seekMasterVolume" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="4dp" android:layout_marginRight="8dp" android:max="100"/>
            <TextView android:textSize="9sp" android:textStyle="bold" android:textColor="#ff00ff00" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M-PITCH"/>
            <SeekBar android:id="@+id/seekMasterPitch" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="4dp" android:layout_marginRight="4dp" android:max="200"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/titleBar" android:background="@drawable/panel_pro" android:padding="6dp" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp">
        <TextView android:textSize="12sp" android:textStyle="bold" android:textColor="#ff00afff" android:id="@+id/txtSelectedPad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SELECTED : PAD 1"/>
        <Button android:textSize="9sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/btnBankA" android:background="@drawable/toggle_pro_off" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="BANK A"/>
        <Button android:textSize="9sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/btnBankB" android:background="@drawable/toggle_pro_off" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="BANK B"/>
        <Button android:textSize="9sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/btnBankAB" android:background="@drawable/toggle_pro_off" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="A+B"/>
        <Button android:textSize="12sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/btnLoops" android:background="@drawable/btn_3d_green" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginLeft="8dp" android:text="LOOPS"/>
        <Button android:id="@+id/btnStopLoop" android:textSize="12sp" android:textStyle="bold" android:textColor="#ffffffff" android:background="@drawable/btn_3d_red" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginLeft="8dp" android:text="STOP" android:onClick="onStopLoopClick"/>
    </LinearLayout>
    <!-- Favorite Kit Bank (MainActivity): tap = switch, long-press = save -->
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/favDrumRow" android:background="@drawable/panel_pro" android:padding="2dp" android:layout_width="match_parent" android:layout_height="34dp">
        <TextView android:textSize="9sp" android:textStyle="bold" android:textColor="#ffaaaaaa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="2dp" android:text="⭐FAV"/>
        <Button android:textSize="10sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/favDrum1" android:background="@drawable/btn_3d_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="3dp" android:text="·1" android:layout_weight="1"/>
        <Button android:textSize="10sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/favDrum2" android:background="@drawable/btn_3d_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="3dp" android:text="·2" android:layout_weight="1"/>
        <Button android:textSize="10sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/favDrum3" android:background="@drawable/btn_3d_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="3dp" android:text="·3" android:layout_weight="1"/>
        <Button android:textSize="10sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/favDrum4" android:background="@drawable/btn_3d_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="3dp" android:text="·4" android:layout_weight="1"/>
        <Button android:textSize="10sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/favDrum5" android:background="@drawable/btn_3d_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="3dp" android:text="·5" android:layout_weight="1"/>
        <Button android:textSize="10sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/favDrum6" android:background="@drawable/btn_3d_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="3dp" android:text="·6" android:layout_weight="1"/>
        <Button android:textSize="10sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/favDrum7" android:background="@drawable/btn_3d_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="3dp" android:text="·7" android:layout_weight="1"/>
        <Button android:textSize="10sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/favDrum8" android:background="@drawable/btn_3d_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="3dp" android:text="·8" android:layout_weight="1"/>
        <Button android:textSize="10sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/favDrum9" android:background="@drawable/btn_3d_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="3dp" android:text="·9" android:layout_weight="1"/>
        <Button android:textSize="10sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/favDrum10" android:background="@drawable/btn_3d_dark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="3dp" android:text="10" android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:id="@+id/padArea" android:background="#ff55595c" android:padding="6dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_weight="2">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:textSize="22sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/pad1" android:background="@drawable/pad_black_selector" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="6dp" android:text="PAD 1" android:layout_weight="1"/>
            <Button android:textSize="22sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/pad2" android:background="@drawable/pad_black_selector" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="6dp" android:text="PAD 2" android:layout_weight="1"/>
            <Button android:textSize="22sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/pad3" android:background="@drawable/pad_black_selector" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="6dp" android:text="PAD 3" android:layout_weight="1"/>
            <Button android:textSize="22sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/pad4" android:background="@drawable/pad_black_selector" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="6dp" android:text="PAD 4" android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:textSize="22sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/pad5" android:background="@drawable/pad_black_selector" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="6dp" android:text="PAD 5" android:layout_weight="1"/>
            <Button android:textSize="22sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/pad6" android:background="@drawable/pad_black_selector" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="6dp" android:text="PAD 6" android:layout_weight="1"/>
            <Button android:textSize="22sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/pad7" android:background="@drawable/pad_black_selector" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="6dp" android:text="PAD 7" android:layout_weight="1"/>
            <Button android:textSize="22sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/pad8" android:background="@drawable/pad_black_selector" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="6dp" android:text="PAD 8" android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
