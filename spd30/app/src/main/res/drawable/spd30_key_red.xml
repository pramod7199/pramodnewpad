<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <gradient android:angle="270" android:startColor="#ffff9aa0"
                android:endColor="#ffc9424c" />
            <stroke android:width="1dp" android:color="#ff76232a" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#ff090506" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <gradient android:angle="270" android:startColor="#ffffd4d7"
                        android:endColor="#ffcd6870" />
                    <stroke android:width="1dp" android:color="#ff76232a" />
                    <padding android:left="3dp" android:top="2dp"
                        android:right="3dp" android:bottom="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
