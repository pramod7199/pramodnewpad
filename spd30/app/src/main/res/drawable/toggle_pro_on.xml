<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="270" android:startColor="#FF087E91"
                android:endColor="#FF06424F" />
            <stroke android:width="1dp" android:color="#FF83F4FF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#FF031A20" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient android:angle="270" android:startColor="#FF12A3B5"
                        android:endColor="#FF075260" />
                    <stroke android:width="1dp" android:color="#FF72EAF4" />
                    <padding android:left="3dp" android:top="2dp"
                        android:right="3dp" android:bottom="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
