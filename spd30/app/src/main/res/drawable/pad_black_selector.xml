<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <gradient android:startColor="#FF383A3C" android:endColor="#FF171819" android:angle="270" android:centerColor="#FF2B2D2F"/>
                    <stroke android:width="3dp" android:color="#FFB7B9BB"/>
                    <padding android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="6dp" android:top="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <solid android:color="#FF05090E"/>
                </shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <gradient android:startColor="#FF56595B" android:endColor="#FF111213" android:angle="270" android:centerColor="#FF3B3D3F"/>
                    <stroke android:width="2dp" android:color="#FFD4D5D6"/>
                    <padding android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp"/>
                </shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <gradient android:startColor="#77ffffff" android:endColor="#00ffffff" android:angle="270" android:centerY="0.3" android:centerColor="#11ffffff"/>
                </shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <gradient android:startColor="#00000000" android:endColor="#aa000000" android:angle="270" android:centerY="0.7" android:centerColor="#00000000"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
