<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Octapad Admin"
        android:icon="@drawable/ic_admin_launcher"
        android:roundIcon="@drawable/ic_admin_launcher"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:allowBackup="true">

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_admin_launcher"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="admin_requests"/>

        <activity
            android:name=".AdminLoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <service
            android:name=".AdminMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

    </application>
</manifest>
