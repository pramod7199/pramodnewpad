<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF08090C"
    android:orientation="horizontal"
    android:padding="5dp">

    <com.pramod.piano.PianoPitchBendView
        android:id="@+id/pitchBend"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="5dp"
        android:background="@drawable/panel_dark"
        android:contentDescription="Vertical pitch bend control" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/panel_dark"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FF08090C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="104dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="PRAMOD\nPIANO"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="0.9"
                android:background="@drawable/lcd_display"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INSTRUMENT"
                    android:textColor="#FF63734A"
                    android:textSize="7sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtActiveInstrument"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Loading..."
                    android:textColor="#FF29341D"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerPreset"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="0.75"
                android:enabled="false" />

            <Button
                android:id="@+id/btnLoadSoundFont"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="60dp"
                android:text="LOAD SF2"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPresetPrevious"
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:text="−"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPresetNext"
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:text="+"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnImportAudio"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:text="ADD WAV/MP3"
                android:textSize="8sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnMidiIn"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="USB MIDI IN"
                android:textSize="8sp" />

            <Button
                android:id="@+id/btnMidiOut"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:text="USB MIDI OUT"
                android:textSize="8sp" />

            <Button
                android:id="@+id/btnZoomOut"
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:text="− ZOOM"
                android:textSize="7sp" />

            <Button
                android:id="@+id/btnZoomIn"
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:text="+ ZOOM"
                android:textSize="7sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOctaveDown"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:text="− OCT"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/txtOctave"
                android:layout_width="54dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="OCT 0"
                android:textColor="#FFE8F0FF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOctaveUp"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:text="+ OCT"
                android:textSize="8sp" />

            <Button
                android:id="@+id/btnScrollLock"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:text="SCROLL"
                android:textSize="8sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="MASTER"
                android:textColor="#FFFFB29A"
                android:textSize="8sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekMasterVolume"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtMasterVolume"
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="80%"
                android:textColor="#FFE8F0FF"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="0.8"
                android:ellipsize="end"
                android:gravity="center_vertical|end"
                android:maxLines="1"
                android:text="READY"
                android:textColor="#FFB8C6D9"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="EQ"
                android:textColor="#FFFFB29A"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOW"
                android:textColor="#FFD5DCE7"
                android:textSize="8sp" />

            <SeekBar
                android:id="@+id/seekEqLow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtEqLow"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="0 dB"
                android:textColor="#FFE8F0FF"
                android:textSize="7sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MID"
                android:textColor="#FFD5DCE7"
                android:textSize="8sp" />

            <SeekBar
                android:id="@+id/seekEqMid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtEqMid"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="0 dB"
                android:textColor="#FFE8F0FF"
                android:textSize="7sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH"
                android:textColor="#FFD5DCE7"
                android:textSize="8sp" />

            <SeekBar
                android:id="@+id/seekEqHigh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtEqHigh"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="0 dB"
                android:textColor="#FFE8F0FF"
                android:textSize="7sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="2dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/favoriteBanksRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chordRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <com.pramod.piano.LockableHorizontalScrollView
            android:id="@+id/keyboardScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="horizontal">

            <com.pramod.piano.PianoKeyboardView
                android:id="@+id/pianoKeyboard"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />
        </com.pramod.piano.LockableHorizontalScrollView>
    </LinearLayout>
</LinearLayout>
