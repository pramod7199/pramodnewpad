<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#FF315FC0" />
            <stroke android:width="1dp" android:color="#FF8BB4FF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="10dp" />
            <gradient android:angle="270" android:startColor="#FF344A6D"
                android:endColor="#FF1E2D45" />
            <stroke android:width="1dp" android:color="#FF5374A8" />
        </shape>
    </item>
</selector>
